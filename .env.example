# ============ 大模型（Agent 对话 / 回复生成）============
# 生成输入为纯文本（命中图片的配图描述、截图的预分析文字均以文本注入，见设计文档 7.7），
# 故此处无需视觉能力；视觉相关能力由下方 VLM_* 承担。
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# LLM_API_KEY 留空则回退 SILICONFLOW_API_KEY
LLM_API_KEY=

# ============ 多模态嵌入（文本优先，见 7.2）============
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
# EMBEDDING_API_KEY 留空则回退 SILICONFLOW_API_KEY
EMBEDDING_API_KEY=
# EMBEDDING_DIM：索引与查询必须一致；改动后必须重建索引
EMBEDDING_DIM=1024
# EMBEDDING_MAX_IMAGE_SIDE：入库/喂图前降采样的长边像素上限
EMBEDDING_MAX_IMAGE_SIDE=1024
# EMBEDDING_MAX_IMAGE_BYTES：图片编码后字节上限（硅基流动视觉接口约 32KB）
EMBEDDING_MAX_IMAGE_BYTES=32000

# ============ 检索精排（可关闭）============
RERANKER_ENABLED=true
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-8B
RERANKER_API_KEY=
RERANKER_TOP_N=3

# ============ 视觉理解（截图语义 / 配图描述，见 8.2）============
VLM_BASE_URL=https://api.siliconflow.cn/v1
VLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# 留空则回退 SILICONFLOW_API_KEY / LLM_API_KEY
VLM_API_KEY=

# ============ 语音识别 / 合成 ============
# ASR_PROVIDER：api | local（local 需自行 pip install funasr，未装会报错）
ASR_PROVIDER=api
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
ASR_API_KEY=
# TTS_PROVIDER：edge（本地，免费）| api
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ============ OCR ============
# OCR_PROVIDER：local(PaddleOCR，需自行 pip install paddleocr paddlepaddle) | api(复用 VLM)
OCR_PROVIDER=local
OCR_BASE_URL=
OCR_MODEL=
OCR_API_KEY=

# ============ 供应商默认 Key（同一供应商复用一个 Key）============
SILICONFLOW_API_KEY=

# ============ 检索参数 ============
RETRIEVAL_TOP_K=10
# RETRIEVAL_MIN_SCORE：未接入检索流程（预留配置，当前不生效）；如启用须作用于精排分并实测校准（见 7.4 注意）
RETRIEVAL_MIN_SCORE=0

# ============ 向量库（嵌入式，零容器）============
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=mde_knowledge

# ============ 关系数据库（中台业务库）============
DB_PATH=./data/app.db

# ============ 媒体存储（图片/音频附件）============
MEDIA_DIR=./data/media

# ============ 认证 ============
TOKEN_EXPIRE_HOURS=8

# ============ RAG 护栏阈值（转人工触发，见 6.3）============
# 必须按所用重排模型的实测分数分布校准。参考本机 Qwen3-VL-Reranker-8B 实测：
# 命中问答 0.20~0.70、知识库未覆盖的 IT 问题 0.03~0.06、寒暄/闲聊 <=0.019，取 0.15
HANDOFF_MIN_CONFIDENCE=0.15
HANDOFF_NEGATIVE_ROUNDS=2
HANDOFF_UNRESOLVED_ROUNDS=3

# ============ 知识库约束（见 7.6）============
KB_MAX_FILE_MB=10
KB_MAX_DOCUMENTS=50
# 入库时为每张配图生成文本描述（写入文本空间作主召回）；VLM 未配置时自动跳过、回退页正文
KB_IMAGE_CAPTION_ENABLED=true

# ============ CrewAI 多 Agent 编排（见 4.1 / 4.2）============
# false：中台直连 LLM 流式生成，逐字输出、首字快
# true（默认）：走 CrewAI 一线/工单/质检编排（Agent 自主调工具），回复同样逐字流式
#   （CrewAI 本身支持流式；另需 provider 补丁剥离供应商逐 chunk 回传的 usage，否则丢正文，详见 crew_agents.py）
CREW_ENABLED=true
CREW_VERBOSE=true
CREW_MAX_ITER=5
CREW_MAX_RPM=10
# CREW_QA_ENABLED：质检 Agent 为旁路复核，默认关闭以省一次 LLM 往返
CREW_QA_ENABLED=false

# ============ 全栈评测（admin「评测」页，见第十七章）============
# 每个套件最多跑 EVAL_MAX_CASES 条，控制外部 API 成本
EVAL_MAX_CASES=20
EVAL_CONCURRENCY=2
# 各维度 PASS/FAIL 阈值（ASR/TTS 的 CER 越低越好，其余越高越好）
EVAL_THRESHOLD_ASR_CER=0.15
EVAL_THRESHOLD_TTS_CER=0.15
EVAL_THRESHOLD_VLM_FIELD_ACC=0.67
EVAL_THRESHOLD_CAPTION_KEYPOINT=0.60
EVAL_THRESHOLD_RETRIEVAL_RECALL=0.70

# ============ MCP Server 启动参数（见 4.3 / 5.4）============
# 留空则用 sys.executable
MCP_SERVER_COMMAND=
MCP_SERVER_SCRIPT=mcp_servers/it_service/server.py
# 留空则用 MCP Server 默认；Docker 内由 compose 映射到 /app/data/tickets.db
TICKETS_DB_PATH=
